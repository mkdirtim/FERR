# Ubuntu-based "bench" container for running third-party OSS hacking agents locally.
#
# Goal:
# - Python 3.12+ toolchains (uv/poetry friendly)
# - Browser automation deps (Playwright/Chromium)
# - Baseline CLI/pentest utilities
#
# This is intentionally not a full Kali image; use Dockerfile.kali for that.

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    jq \
    ripgrep \
    unzip \
    make \
    build-essential \
    python3.12 \
    python3.12-venv \
    python3-pip \
    # baseline network/pentest utilities
    nmap \
    netcat-openbsd \
    dnsutils \
    whois \
    iputils-ping \
    iproute2 \
    tcpdump \
    # browser deps (Playwright-compatible) + system chromium
    chromium \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libxshmfence1 \
    xdg-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# uv + poetry for Python repos in ./bench/projects
RUN set -eux; \
    curl -fsSL https://astral.sh/uv/install.sh | sh; \
    cp /root/.local/bin/uv /usr/local/bin/uv; \
    uv venv /opt/poetry; \
    VIRTUAL_ENV=/opt/poetry uv pip install poetry; \
    ln -s /opt/poetry/bin/poetry /usr/local/bin/poetry

RUN setcap cap_net_raw,cap_net_admin,cap_net_bind_service+eip "$(which nmap)"

RUN useradd -m -s /bin/bash bench && \
    mkdir -p /work /playground && \
    chown -R bench:bench /work /playground

COPY bench/bench-init.sh /usr/local/bin/bench-init.sh
RUN chmod +x /usr/local/bin/bench-init.sh

USER bench
WORKDIR /work

ENV PYTHONUNBUFFERED=1
ENV PATH="/home/bench/.local/bin:${PATH}"

# Put each project's .venv/bin on PATH so CLIs are available in every shell.
RUN echo '\n# bench project venvs\n\
for d in /playground/projects/*/; do\n\
  [ -d "${d}.venv/bin" ] && export PATH="${d}.venv/bin:$PATH"\n\
done' >> /home/bench/.bashrc

ENTRYPOINT ["bench-init.sh"]
CMD ["/bin/bash"]

