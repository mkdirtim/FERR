#!/usr/bin/env bash
# bench-strix — Run N Strix benchmark runs per target with clean restarts.
#
# Usage:  ./bin/bench-strix [RUNS]
#         RUNS defaults to 5.
#
# Requires: STRIX_LLM and LLM_API_KEY set in playground.env
# Each run: archive /tmp → restart target → wait healthy → run Strix → archive strix_runs.

set -euo pipefail

RUNS="${1:-5}"
KALI="playground-kali"

# target-name  container-name       url                      healthcheck-path
TARGETS=(
  "juiceshop   targets-juiceshop    http://juiceshop:3000    /rest/admin/application-version"
  "badstore    targets-badstore     http://badstore:80       /"
)

log() { printf '\n\033[1;34m>>> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m    %s\033[0m\n' "$*"; }

archive_tmp() {
  local archive_path="$1"
  docker exec "$KALI" bash -c \
    'items=$(find /tmp -mindepth 1 -maxdepth 1 2>/dev/null)
     if [ -n "$items" ]; then
       tar czf "'"${archive_path}"'" $items 2>/dev/null && rm -rf $items
       echo "Archived $(echo "$items" | wc -l | xargs) items"
     else
       echo "No /tmp artifacts to archive"
     fi'
}

wait_for_target() {
  local url="$1"
  local path="$2"
  local max_wait=60
  local elapsed=0

  while ! docker exec "$KALI" curl -sf "${url}${path}" -o /dev/null 2>/dev/null; do
    sleep 2
    elapsed=$((elapsed + 2))
    if [ "$elapsed" -ge "$max_wait" ]; then
      warn "Target ${url} not ready after ${max_wait}s — skipping"
      return 1
    fi
  done
  return 0
}

for entry in "${TARGETS[@]}"; do
  read -r name container url health_path <<< "$entry"

  log_dir="/playground/scans/${name}/strix/results"

  # Ensure output directory exists inside the container
  docker exec "$KALI" mkdir -p "$log_dir"

  for run in $(seq 1 "$RUNS"); do
    log "${name} — run ${run}/${RUNS}"

    # 1. Archive /tmp from previous run
    log "Archiving /tmp artifacts from previous run..."
    archive_tmp "${log_dir}/strix-run-$((run - 1))-tmp.tar.gz"

    # 2. Restart the target container for a clean state
    log "Restarting ${container}..."
    docker restart "$container" > /dev/null
    sleep 3

    # 3. Wait until the target responds
    log "Waiting for ${url}..."
    if ! wait_for_target "$url" "$health_path"; then
      warn "Skipping ${name} run ${run}"
      continue
    fi
    log "Target ready."

    # 4. Run Strix (non-interactive, deep scan)
    logfile="${log_dir}/strix-run-${run}.log"
    log "Running Strix → ${logfile}"
    docker exec "$KALI" bash -c \
      "strix -n --target '${url}' --scan-mode deep 2>&1 | tee '${logfile}'"

    # 5. Archive strix_runs/ output directory if it exists
    docker exec "$KALI" bash -c \
      'if [ -d /work/strix_runs ]; then
         tar czf "'"${log_dir}/strix-run-${run}-output.tar.gz"'" -C /work strix_runs 2>/dev/null
         rm -rf /work/strix_runs
         echo "Archived strix_runs/ output"
       fi'

    log "${name} — run ${run} complete."
  done

  # Archive /tmp artifacts from the final run
  log "Archiving /tmp artifacts from final run..."
  archive_tmp "${log_dir}/strix-run-${RUNS}-tmp.tar.gz"
done

log "All benchmark runs finished."
