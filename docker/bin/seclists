#!/usr/bin/env bash
# Download SecLists wordlists (one-time setup)
# SecLists is large - this script downloads it once to share with containers

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SECLISTS_DIR="$ROOT_DIR/data/seclists"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

if [ -d "$SECLISTS_DIR/.git" ]; then
    echo -e "${GREEN}✓ SecLists already downloaded${NC}"
    echo "Location: $SECLISTS_DIR"

    read -p "Update SecLists to latest version? (y/N) " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        echo -e "${YELLOW}Updating SecLists...${NC}"
        cd "$SECLISTS_DIR"
        git pull
        echo -e "${GREEN}✓ SecLists updated${NC}"
    fi
    exit 0
fi

echo -e "${YELLOW}Downloading SecLists...${NC}"
echo "This is a one-time download. The files will be shared with Docker containers."

mkdir -p "$ROOT_DIR/data"

cd "$ROOT_DIR/data"
git clone --depth 1 https://github.com/danielmiessler/SecLists.git seclists

read -p "Remove .git directory to save space? (Y/n) " -n 1 -r
echo
if [[ ! $REPLY =~ ^[Nn]$ ]]; then
    rm -rf seclists/.git
    echo -e "${GREEN}✓ Removed .git directory${NC}"
fi

echo -e "${GREEN}✓ SecLists downloaded successfully${NC}"
echo "Location: $SECLISTS_DIR"
echo ""
echo "SecLists will be available in containers at: /usr/share/wordlists/seclists"
