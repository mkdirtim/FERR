# Playground environment (keys/config) for third-party agent projects.
#
# Copy this file to: ./data/playground.env
# That file is gitignored (see ./data/.gitignore).
#
# Notes:
# - PentestGPT uses Claude Code (`claude`) and requires an interactive `/login`.
# - CAI is a TUI and must be run from an interactive `docker compose exec playground bash`.
# - Strix requires STRIX_LLM and typically LLM_API_KEY (unless using a local/provider auth flow).

# ---- Strix (Litellm-style model id) ----
STRIX_LLM=openai/gpt-5
LLM_API_KEY=
LLM_API_BASE=
PERPLEXITY_API_KEY=

# ---- CAI / OpenAI-compatible backends ----
OPENAI_API_KEY=sk-1234
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ALIAS_API_KEY=
OLLAMA=
OLLAMA_API_BASE=
CAI_MODEL=alias1
CAI_OPENAI_API_KEY=

# ---- UX ----
PROMPT_TOOLKIT_NO_CPR=1
CAI_STREAM=false
