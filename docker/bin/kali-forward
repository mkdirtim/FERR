#!/usr/bin/env bash
# Forward Docker target ports to the Kali VM via SSH remote forwarding.
#
# Docker Desktop on macOS can only bind to 127.0.0.1 or 0.0.0.0.
# This script tunnels the localhost-bound target ports into the Kali VM
# so they're reachable at localhost:<port> inside the VM.
#
# Usage:
#   ./bin/kali-forward              # uses SSH host "kaliutm"
#   ./bin/kali-forward myhost       # uses a custom SSH host
#   ./bin/kali-forward --stop       # kill a running tunnel

set -euo pipefail

SSH_HOST="${1:-kaliutm}"
PID_FILE="/tmp/openhack-kali-forward.pid"

# Target ports: host_port -> 127.0.0.1:host_port
PORTS=(3333 3334 3335 3336 3337 3338)

stop_tunnel() {
    if [ -f "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            kill "$pid"
            echo "Stopped tunnel (pid $pid)"
        else
            echo "Tunnel process $pid already gone"
        fi
        rm -f "$PID_FILE"
    else
        echo "No tunnel running"
    fi
}

if [ "${1:-}" = "--stop" ]; then
    stop_tunnel
    exit 0
fi

# Stop any existing tunnel first
stop_tunnel 2>/dev/null || true

# Build -R flags: -R <port>:127.0.0.1:<port> for each target
SSH_ARGS=()
for port in "${PORTS[@]}"; do
    SSH_ARGS+=(-R "${port}:127.0.0.1:${port}")
done

echo "Forwarding target ports to ${SSH_HOST}..."
printf "  %s\n" "${PORTS[@]}"

# Run SSH in background: no remote command, just keep the tunnel open
ssh -f -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 \
    "${SSH_ARGS[@]}" "$SSH_HOST"

# Find the ssh process we just started
pgrep -nf "ssh.*-N.*${SSH_HOST}" > "$PID_FILE" 2>/dev/null || true

echo ""
echo "Tunnel active (pid $(cat "$PID_FILE" 2>/dev/null || echo '?'))"
echo "Inside the Kali VM, targets are at:"
echo "  Juice Shop:  http://localhost:3333"
echo "  DVWA:        http://localhost:3334"
echo "  bWAPP:       http://localhost:3335"
echo "  BadStore:    http://localhost:3336"
echo "  WebGoat:     http://localhost:3337"
echo "  WebWolf:     http://localhost:3338"
echo ""
echo "Stop with: $0 --stop"
