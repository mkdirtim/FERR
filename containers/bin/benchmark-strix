#!/usr/bin/env bash
# benchmark-strix — Run N Strix benchmark runs per target with clean restarts.
#
# Usage:  ./bin/benchmark-strix [RUNS] [START]
#         RUNS defaults to 5, START defaults to 1.
#         TARGET=name to run a single target (default: all).
#
#         Examples:
#           ./bin/benchmark-strix 5 3                  — runs 3-5 on all targets
#           TARGET=badstore ./bin/benchmark-strix 5    — all 5 runs, badstore only
#           TARGET=juiceshop ./bin/benchmark-strix 3 3 — just run 3, juiceshop only
#
# Requires: STRIX_LLM and LLM_API_KEY set in data/projects/playground.env
# Each run: clean /tmp → restart target → wait healthy → run Strix → archive /tmp + strix_runs.

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=benchmark-common
source "${SCRIPT_DIR}/benchmark-common"

STRIX="/playground/projects/source/strix/.venv/bin/strix"

for entry in "${TARGETS[@]}"; do
  read -r name container url health_path <<< "$entry"

  # Skip targets not matching TARGET filter (if set)
  if [ -n "${TARGET:-}" ] && [ "$name" != "$TARGET" ]; then
    continue
  fi

  for run in $(seq "$START" "$RUNS"); do
    bench_prepare "$name" "$container" "$url" "$health_path" "$run" || continue

    # Run Strix (non-interactive, deep scan)
    #   Structured results are saved by Strix itself into strix_runs/ (archived below).
    #   Strix exits with code 2 when vulnerabilities are found — this is expected.
    log "Running Strix..."
    docker exec "$KALI" bash -c \
      "${STRIX} -n --target '${url}' --scan-mode deep" \
      || true

    # Archive strix_runs/ output directory if it exists
    docker exec "$KALI" bash -c \
      'if [ -d /work/strix_runs ]; then
         tar czf "'"${SCAN_DIR}/${name}-strix-run-${run}-output.tar.gz"'" -C /work strix_runs 2>/dev/null
         rm -rf /work/strix_runs
         echo "Archived strix_runs/ output"
       fi'

    # Archive /tmp artifacts from this run
    log "Archiving /tmp artifacts from run ${run}..."
    archive_tmp "${SCAN_DIR}/${name}-strix-run-${run}-tmp.tar.gz"

    log "${name} — run ${run} complete."
  done
done

log "All benchmark runs finished."
