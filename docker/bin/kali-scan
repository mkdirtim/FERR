#!/usr/bin/env bash
# Scan Docker-internal targets from the playground-kali container.
# Uses Docker DNS hostnames and real service ports.
# Runs nmap, whatweb, nikto, ZAP, ffuf, and sqlmap per target.
# Output: /playground/scans/<hostname>/
#
# Usage:
#   kali-scan                      # scan all targets
#   kali-scan juiceshop            # scan one target
#   kali-scan dvwa webgoat         # scan specific targets
#
# Environment:
#   SCAN_DIR   output directory (default: /playground/scans)
#   WORDLIST   ffuf wordlist   (default: /usr/share/wordlists/dirb/common.txt)

set -euo pipefail

SCAN_DIR="${SCAN_DIR:-/playground/scans}"
WORDLIST="${WORDLIST:-/usr/share/wordlists/dirb/common.txt}"

# Target definitions: name=hostname:port
declare -A TARGET_MAP=(
    [juiceshop]="juiceshop:3000"
    [dvwa]="dvwa:80"
    [bwapp]="bwapp:80"
    [badstore]="badstore:80"
    [webgoat]="webgoat:8080"
)
ALL_TARGETS=(juiceshop dvwa bwapp badstore webgoat)

NMAP_SCRIPTS="default,vuln,http-title,http-headers,http-methods,http-robots.txt,http-enum,http-server-header"

# --- Parse args ---
TARGETS=()
for arg in "$@"; do
    if [[ -v "TARGET_MAP[$arg]" ]]; then
        TARGETS+=("$arg")
    else
        echo "[-] Unknown target: ${arg}"
        echo "    Available: ${ALL_TARGETS[*]}"
        exit 1
    fi
done
if [ ${#TARGETS[@]} -eq 0 ]; then
    TARGETS=("${ALL_TARGETS[@]}")
fi

# ============================================================
# Per-target scan
# ============================================================

scan_target() {
    local name=$1
    local hostport="${TARGET_MAP[$name]}"
    local host="${hostport%%:*}"
    local port="${hostport##*:}"
    local url="http://${host}:${port}"
    local dir="${SCAN_DIR}/${name}"
    mkdir -p "$dir"

    echo "========================================"
    echo "[*] Scanning ${name} (${host}:${port})"
    echo "    Output: ${dir}/"
    echo "========================================"

    # --- nmap ---
    echo "[+] nmap..."
    nmap -p"${port}" -sS -sV --version-all -A --reason -T4 \
        --script "${NMAP_SCRIPTS}" \
        -oN "${dir}/nmap.txt" "$host"
    echo "[+] nmap done: ${dir}/nmap.txt"

    # --- whatweb ---
    echo "[+] whatweb..."
    whatweb -v -a 3 --log-verbose="${dir}/whatweb.txt" \
        "${url}" || true
    echo "[+] whatweb done: ${dir}/whatweb.txt"

    # --- nikto ---
    echo "[+] nikto..."
    nikto -h "${url}" -o "${dir}/nikto.txt" \
        -Format txt || true
    echo "[+] nikto done: ${dir}/nikto.txt"

    # --- sqlmap (crawl + auto) ---
    echo "[+] sqlmap..."
    sqlmap -u "${url}" --crawl=2 --batch --random-agent \
        --output-dir="${dir}/sqlmap" || true
    echo "[+] sqlmap done: ${dir}/sqlmap/"

    # --- ZAP ---
    echo "[+] ZAP quick scan..."
    zaproxy -cmd -silent -quickurl "${url}" \
        -quickout "${dir}/zap.md" -quickprogress || true
    echo "[+] ZAP done: ${dir}/zap.md"

    # --- ffuf (directory brute-force, run last to avoid overwhelming the target) ---
    if [ -f "$WORDLIST" ]; then
        echo "[+] ffuf..."
        ffuf -u "${url}/FUZZ" -w "$WORDLIST" \
            -ac -t 10 -o "${dir}/ffuf.json" \
            -of json || true
        echo "[+] ffuf done: ${dir}/ffuf.json"
    else
        echo "[-] ffuf skipped: wordlist not found (${WORDLIST})"
    fi

    echo "[*] ${name} complete."
    echo ""
}

# ============================================================
# Main
# ============================================================

echo "Targets: ${TARGETS[*]}"
echo "Output:  ${SCAN_DIR}"
echo ""

for target in "${TARGETS[@]}"; do
    scan_target "$target"
done

echo "========================================"
echo "All scans complete."
echo ""
tree "${SCAN_DIR}" 2>/dev/null || find "${SCAN_DIR}" -type f | sort
