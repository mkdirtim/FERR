#!/usr/bin/env bash
# opencodestack startup script
#
# Usage:
#   ./bin/up               # Start with vulnerable targets (default)
#   ./bin/up --no-targets  # Start dev only

set -euo pipefail

WITH_TARGETS=true
if [ "${1:-}" = "--no-targets" ]; then
    WITH_TARGETS=false
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$SCRIPT_DIR/.."
ROOT_DIR="$SCRIPT_DIR/../.."

if [ ! -f "$ROOT_DIR/package.json" ]; then
    echo "❌ Error: package.json not found at $ROOT_DIR"
    exit 1
fi

if [ ! -f "$ROOT_DIR/packages/opencode/package.json" ]; then
    echo "❌ Error: packages/opencode/package.json not found at $ROOT_DIR/packages/opencode/package.json"
    exit 1
fi

if [ "$WITH_TARGETS" = true ]; then
    echo "🚀 Starting opencodestack with vulnerable targets..."
else
    echo "🚀 Starting opencodestack (dev only)..."
fi
echo ""

cd "$CONFIG_DIR"

echo "🔨 Building containers..."
docker compose build

echo ""
if [ "$WITH_TARGETS" = true ]; then
    echo "▶️  Starting services (with vulnerable targets)..."
    docker compose --profile targets up -d
else
    echo "▶️  Starting dev only..."
    docker compose up -d
fi

echo ""
echo "⏳ Waiting for services to be healthy..."
sleep 5

docker compose --profile targets ps

echo ""
echo "✅ opencodestack is running!"
echo ""
echo "🎯 Quick commands:"
echo "   Enter container:  cd $CONFIG_DIR && docker compose exec openhack bash"
echo "   Run opencode web: cd $CONFIG_DIR && make web"
echo "   Run app dev:      cd $CONFIG_DIR && make app"
echo "   Stop services:    cd $CONFIG_DIR && docker compose --profile targets down"
echo ""
