#!/bin/bash
# Test script for openhackstack setup

set -e

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

AUTO_YES="${AUTO_YES:-0}"
auto_read() {
    local prompt="$1"
    if [ "$AUTO_YES" = "1" ]; then
        echo "$prompt (auto-yes)"
        REPLY="y"
    else
        read -p "$prompt" -n 1 -r
        echo
    fi
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="$SCRIPT_DIR/.."
ROOT_DIR="$SCRIPT_DIR/../.."

echo "🧪 Testing openhackstack setup..."
echo ""

echo "=== Test 1: Repository Layout ==="
if [ -f "$ROOT_DIR/package.json" ] && [ -f "$ROOT_DIR/packages/opencode/package.json" ]; then
    echo -e "${GREEN}✓${NC} repo root and packages/opencode found"
else
    echo -e "${RED}✗${NC} expected repo layout not found at $ROOT_DIR"
    exit 1
fi

echo ""
echo "=== Test 2: Docker Compose Configuration ==="
cd "$CONFIG_DIR"
if docker compose --profile targets --profile playground config --services > /dev/null 2>&1; then
    echo -e "${GREEN}✓${NC} docker compose.yml is valid"
    echo "  Services: $(docker compose --profile targets --profile playground config --services | tr '\n' ', ' | sed 's/,$//')"
else
    echo -e "${RED}✗${NC} docker compose.yml has errors"
    exit 1
fi

echo ""
echo "=== Test 3: Build Image ==="
auto_read "Build Docker image? This may take a few minutes. (y/N) "
if [[ $REPLY =~ ^[Yy]$ ]]; then
    echo -e "${YELLOW}Building dev image (service: openhack)...${NC}"
    docker compose build openhack
    echo -e "${GREEN}✓${NC} dev image built successfully"
fi

echo ""
echo "=== Test 4: Start Services ==="
auto_read "Start all services (with targets)? (y/N) "
if [[ $REPLY =~ ^[Yy]$ ]]; then
    echo -e "${YELLOW}Starting services...${NC}"
    docker compose --profile targets up -d
    echo ""

    echo -e "${YELLOW}Waiting for services to initialize (30s)...${NC}"
    sleep 30

    echo ""
    echo "=== Service Status ==="
    docker compose ps
fi

echo ""
echo "=== Test 5: Container Tools ==="
auto_read "Test container access and tools? (y/N) "
if [[ $REPLY =~ ^[Yy]$ ]]; then
    if docker compose ps openhack | grep -q "Up"; then
        echo ""
        echo -e "${GREEN}✓${NC} dev container is running"

        if docker compose exec -T openhack bun --version > /dev/null 2>&1; then
            VERSION=$(docker compose exec -T openhack bun --version)
            echo -e "${GREEN}✓${NC} bun is available (version: $VERSION)"
        else
            echo -e "${RED}✗${NC} bun is NOT available"
        fi

        if docker compose exec -T openhack which nmap > /dev/null 2>&1; then
            echo -e "${GREEN}✓${NC} nmap is available"
        else
            echo -e "${RED}✗${NC} nmap is NOT available"
        fi

        if docker compose exec -T openhack test -f /app/packages/opencode/package.json; then
            echo -e "${GREEN}✓${NC} repo files mounted correctly"
        else
            echo -e "${RED}✗${NC} repo files NOT found in container"
        fi

        if docker compose exec -T openhack test -d /usr/share/wordlists/seclists; then
            echo -e "${GREEN}✓${NC} SecLists wordlists available"
        else
            echo -e "${RED}✗${NC} SecLists wordlists NOT found (image may need rebuild)"
        fi
    else
        echo -e "${RED}✗${NC} dev container is NOT running"
    fi
fi

echo ""
echo "=== Test 6: Vulnerable Applications ==="
auto_read "Test vulnerable application accessibility? (y/N) "
if [[ $REPLY =~ ^[Yy]$ ]]; then
    echo ""
    echo -e "${YELLOW}Testing vulnerable apps (this may take a moment)...${NC}"
    sleep 10

    check_port() {
        local name=$1
        local port=$2
        if curl -s -o /dev/null -w "%{http_code}" "http://localhost:$port" --connect-timeout 5 | grep -q "200\\|302\\|404"; then
            echo -e "${GREEN}✓${NC} $name is accessible on port $port"
        else
            echo -e "${YELLOW}⚠${NC} $name may still be starting on port $port"
        fi
    }

    check_port "Juice Shop" 3333
    check_port "DVWA" 3334
    check_port "bWAPP" 3335
    check_port "BadStore" 3336
    check_port "WebGoat" 3337
fi

echo ""
echo "=== Test Summary ==="
echo ""
echo "Ports:"
echo "  • opencode serve/web: http://localhost:4096"
echo "  • app dev server:     check: docker compose port openhack 3000"
echo ""
echo "Targets (when started with profile 'targets'):"
echo "  • Juice Shop:  http://localhost:3333"
echo "  • DVWA:        http://localhost:3334"
echo "  • bWAPP:       http://localhost:3335"
echo "  • BadStore:    http://localhost:3336"
echo "  • WebGoat:     http://localhost:3337"
echo "  • WebWolf:     http://localhost:3338"
echo ""
echo -e "${GREEN}✓ Testing complete!${NC}"
