│                                                                              │
│          # Show a small excerpt around an internal path if present           │
│          m = re.search(r"(/juice-shop/[^<\\s]+)", body)                      │
│          if m:                                                               │
│              start = max(0, m.start() - 80)                                  │
│              end = min(len(body), m.end() + 80)                              │
│              print("Excerpt:")                                               │
