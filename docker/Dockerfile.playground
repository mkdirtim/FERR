# Kali-based playground container for running third-party OSS hacking agents locally.

FROM kalilinux/kali-last-release@sha256:c77f241fcd12bb7835e09f8fc1073d7d9c7cf50b531808d9afa95e9cb63a6113

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Kali pentesting tools (includes nmap, metasploit, hydra, etc.)
    kali-linux-headless \
    # Not in kali-linux-headless
    nuclei \
    # Agent projects use python + uv/poetry
    python3 \
    python3-venv \
    python3-pip \
    build-essential \
    make \
    # CLI utilities
    jq \
    ripgrep \
    unzip \
    # Skipped by --no-install-recommends (only a Recommend of kali-system-core)
    git \
    # HTTPS for curl, uv, etc.
    ca-certificates \
    # Playwright-compatible Chromium + rendering deps
    chromium \
    fonts-liberation \
    libasound2t64 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdrm2 \
    libgbm1 \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libxshmfence1 \
    xdg-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN setcap cap_net_raw,cap_net_admin,cap_net_bind_service+eip "$(which nmap)"

# uv + poetry for Python repos in ./data/projects
RUN set -eux; \
    curl -fsSL https://astral.sh/uv/install.sh | sh; \
    cp /root/.local/bin/uv /usr/local/bin/uv; \
    uv venv /opt/poetry; \
    VIRTUAL_ENV=/opt/poetry uv pip install poetry; \
    ln -s /opt/poetry/bin/poetry /usr/local/bin/poetry

RUN useradd -m -s /bin/bash playground && \
    mkdir -p /work /playground && \
    chown -R playground:playground /work /playground

COPY entrypoint/playground /usr/local/bin/playground
RUN chmod +x /usr/local/bin/playground

USER playground
WORKDIR /work

ENV PYTHONUNBUFFERED=1
ENV PATH="/home/playground/.local/bin:${PATH}"

# Put each project's .venv/bin on PATH so CLIs are available in every shell.
RUN echo '\n# playground project venvs\n\
for d in /playground/projects/*/; do\n\
  [ -d "${d}.venv/bin" ] && export PATH="${d}.venv/bin:$PATH"\n\
done' >> /home/playground/.bashrc

ENTRYPOINT ["playground"]
CMD ["/bin/bash"]
