#!/usr/bin/env bash
# Clone third-party agent projects (one-time setup)
# Projects are bind-mounted into the playground container at /playground/projects

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECTS_DIR="$ROOT_DIR/data/projects/source"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

declare -A REPOS=(
    [PentestGPT]="https://github.com/GreyDGL/PentestGPT.git"
    [cai]="https://github.com/aliasrobotics/cai.git"
    [strix]="https://github.com/usestrix/strix.git"
)

mkdir -p "$PROJECTS_DIR"

clone_or_update() {
    local name=$1
    local url=$2
    local dir="$PROJECTS_DIR/$name"

    if [ -d "$dir/.git" ]; then
        echo -e "${GREEN}✓${NC} $name already cloned"
        read -p "  Update $name to latest? (y/N) " -n 1 -r
        echo
        if [[ $REPLY =~ ^[Yy]$ ]]; then
            echo -e "  ${YELLOW}Pulling latest...${NC}"
            git -C "$dir" pull
            echo -e "  ${GREEN}✓ $name updated${NC}"
        fi
    else
        echo -e "${YELLOW}Cloning $name...${NC}"
        git clone --depth 1 "$url" "$dir"
        echo -e "${GREEN}✓ $name cloned${NC}"
    fi
}

echo "Setting up playground projects..."
echo ""

for name in "${!REPOS[@]}"; do
    clone_or_update "$name" "${REPOS[$name]}"
    echo ""
done

echo -e "${GREEN}✓ All projects ready${NC}"
echo "Location: $PROJECTS_DIR"
echo ""
echo "Projects will be available in the playground container at: /playground/projects/source"
echo "Start the playground with: make playground"
