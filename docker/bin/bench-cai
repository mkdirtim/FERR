#!/usr/bin/env bash
# bench-cai — Run N CAI benchmark runs per target with clean restarts.
#
# Usage:  ./bin/bench-cai [RUNS] [START]
#         RUNS defaults to 5, START defaults to 1.
#         TARGET=name to run a single target (default: all).
#
#         Examples:
#           ./bin/bench-cai 5 3                  — runs 3-5 on all targets
#           TARGET=badstore ./bin/bench-cai 5    — all 5 runs, badstore only
#           TARGET=juiceshop ./bin/bench-cai 3 3 — just run 3, juiceshop only
#
# Requires: OPENAI_API_KEY and CAI_MODEL set in data/projects/playground.env
# Note: CAI requires a TTY. This script allocates one via docker exec -t.
# Each run: clean /tmp → restart target → wait healthy → run CAI → archive /tmp.

set -euo pipefail

RUNS="${1:-5}"
START="${2:-1}"
KALI="playground-kali"
CAI="/playground/projects/source/cai/.venv/bin/cai"

# target-name  container-name       url                      healthcheck-path
TARGETS=(
  "juiceshop   targets-juiceshop    http://juiceshop:3000    /rest/admin/application-version"
  "badstore    targets-badstore     http://badstore:80       /"
)

log() { printf '\n\033[1;34m>>> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m    %s\033[0m\n' "$*"; }

clean_tmp() {
  docker exec "$KALI" bash -c \
    'items=$(find /tmp -mindepth 1 -maxdepth 1 ! -name "hsperfdata_*" 2>/dev/null)
     if [ -n "$items" ]; then
       rm -rf $items 2>/dev/null
       echo "Cleaned $(echo "$items" | wc -l | xargs) items from /tmp"
     else
       echo "/tmp already clean"
     fi'
}

archive_tmp() {
  local archive_path="$1"
  docker exec "$KALI" bash -c \
    'items=$(find /tmp -mindepth 1 -maxdepth 1 ! -name "hsperfdata_*" 2>/dev/null)
     if [ -n "$items" ]; then
       tar czf "'"${archive_path}"'" $items 2>/dev/null && rm -rf $items 2>/dev/null
       echo "Archived $(echo "$items" | wc -l | xargs) items"
     else
       echo "No /tmp artifacts to archive"
     fi'
}

wait_for_target() {
  local url="$1"
  local path="$2"
  local max_wait=60
  local elapsed=0

  while ! docker exec "$KALI" curl -sf "${url}${path}" -o /dev/null 2>/dev/null; do
    sleep 2
    elapsed=$((elapsed + 2))
    if [ "$elapsed" -ge "$max_wait" ]; then
      warn "Target ${url} not ready after ${max_wait}s — skipping"
      return 1
    fi
  done
  return 0
}

for entry in "${TARGETS[@]}"; do
  read -r name container url health_path <<< "$entry"

  # Skip targets not matching TARGET filter (if set)
  if [ -n "${TARGET:-}" ] && [ "$name" != "$TARGET" ]; then
    continue
  fi

  log_dir="/playground/scans/${name}/cai"

  # Ensure output directory exists inside the container
  docker exec "$KALI" mkdir -p "$log_dir"

  for run in $(seq "$START" "$RUNS"); do
    log "${name} — run ${run}/${RUNS}"

    # 1. Clean /tmp
    log "Cleaning /tmp..."
    clean_tmp

    # 2. Restart the target container for a clean state
    log "Restarting ${container}..."
    docker restart "$container" > /dev/null
    sleep 3

    # 3. Wait until the target responds
    log "Waiting for ${url}..."
    if ! wait_for_target "$url" "$health_path"; then
      warn "Skipping ${name} run ${run}"
      continue
    fi
    log "Target ready."

    # 4. Run CAI
    #    -t allocates a TTY (required by CAI's prompt_toolkit)
    #    CAI_DEBUG=1 for standard verbosity
    #    CAI_PRICE_LIMIT=10 to avoid early cost cutoff
    #    CAI_MAX_TURNS caps LLM round-trips; timeout kills the idle CAI> prompt
    logfile="${log_dir}/cai-run-${run}.log"
    stall_timeout="${CAI_STALL_TIMEOUT:-120}"  # kill if no output for 2 min
    log "Running CAI → ${logfile}"
    docker exec -t "$KALI" bash -c \
      "CAI_DEBUG=1 CAI_PRICE_LIMIT=10 CAI_MAX_TURNS=${CAI_MAX_TURNS:-100} timeout --signal=INT --kill-after=10 ${CAI_TIMEOUT:-1800} ${CAI} 'Target in scope: ${url}. Write findings to /tmp/report.md.' 2>/dev/null | tee '${logfile}'" &
    cai_pid=$!

    # Stall watchdog: kill CAI if log file stops growing for $stall_timeout seconds
    (
      while kill -0 "$cai_pid" 2>/dev/null; do
        prev_size=$(docker exec "$KALI" stat -c%s "${logfile}" 2>/dev/null || echo 0)
        sleep "$stall_timeout"
        if ! kill -0 "$cai_pid" 2>/dev/null; then break; fi
        curr_size=$(docker exec "$KALI" stat -c%s "${logfile}" 2>/dev/null || echo 0)
        if [ "$prev_size" = "$curr_size" ]; then
          warn "STALL DETECTED: no output for ${stall_timeout}s — killing CAI"
          echo "[STALL] No output for ${stall_timeout}s at $(date -u +%FT%TZ)" | \
            docker exec -i "$KALI" tee -a "${logfile}" > /dev/null
          docker exec "$KALI" pkill -9 -f "bin/cai" 2>/dev/null || true
          break
        fi
      done
    ) &
    watchdog_pid=$!

    wait "$cai_pid" || true
    kill "$watchdog_pid" 2>/dev/null || true
    wait "$watchdog_pid" 2>/dev/null || true

    # 5. Archive CAI session logs (JSONL with full LLM transcripts)
    docker exec "$KALI" bash -c \
      'if [ -d /playground/projects/source/cai/logs ] && ls /playground/projects/source/cai/logs/*.jsonl 1>/dev/null 2>&1; then
         tar czf "'"${log_dir}/cai-run-${run}-session.tar.gz"'" -C /playground/projects/source/cai logs/*.jsonl 2>/dev/null
         rm -f /playground/projects/source/cai/logs/*.jsonl
         echo "Archived CAI session logs"
       else
         echo "No CAI session logs to archive"
       fi'

    # 6. Archive /tmp artifacts from this run
    log "Archiving /tmp artifacts from run ${run}..."
    archive_tmp "${log_dir}/cai-run-${run}-tmp.tar.gz"

    log "${name} — run ${run} complete."
  done
done

log "All benchmark runs finished."
