# Kali-based container for OpenCode development + pentesting tools
FROM kalilinux/kali-last-release@sha256:c77f241fcd12bb7835e09f8fc1073d7d9c7cf50b531808d9afa95e9cb63a6113

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    # Kali pentesting tools (includes nmap, metasploit, hydra, etc.)
    kali-linux-headless \
    # Not in kali-linux-headless
    nuclei \
    # Scripting / native module builds
    python3 \
    python3-venv \
    build-essential \
    make \
    # CLI utilities
    jq \
    ripgrep \
    unzip \
    # Skipped by --no-install-recommends (only a recommend of kali-system-core)
    git \
    # HTTPS for curl, bun install, etc.
    ca-certificates \
    # setcap for nmap raw sockets as non-root
    libcap2-bin \
    # MCP servers run via `npx -y ...` inside this container
    nodejs \
    npm \
    # Playwright MCP needs Chromium + rendering deps
    chromium \
    fonts-liberation \
    xdg-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN setcap cap_net_raw,cap_net_admin,cap_net_bind_service+eip "$(which nmap)"

ENV BUN_INSTALL=/opt/bun
RUN set -eux; \
    mkdir -p /opt/bun; \
    curl -fsSL https://bun.sh/install | bash; \
    test -x /opt/bun/bin/bun; \
    ln -s /opt/bun/bin/bun /usr/local/bin/bun

WORKDIR /app

RUN mkdir -p /usr/share/wordlists/seclists

RUN useradd -m -s /bin/bash opencode && \
    chown -R opencode:opencode /app /opt/bun

USER opencode

ENV PYTHONUNBUFFERED=1
ENV PATH="/opt/bun/bin:/home/opencode/.local/bin:${PATH}"

RUN printf '\n# openhackstack shell helper\nif [ -n "$PS1" ] && [ "$$" -ne 1 ]; then\n  echo \"openhackstack: repo mounted at /app\";\n  echo \"openhackstack: from host run: make -C docker help\";\nfi\n' >> /home/opencode/.bashrc

EXPOSE 4096 3000

CMD ["/bin/bash"]
